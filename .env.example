# Environment Variables Example
# Copy this to .env and fill in the values

# Application
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=generate_a_secure_random_string_here

# Database — LOCAL development (without Docker)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/guest_housing

# Database — Docker Compose (use this when running via docker compose)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/university_housing

# CORS allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Mobile app (API URL for the React Native client)
API_BASE_URL=http://localhost:8000