# Environment Variables Example
# Copy this file to backend/.env and fill in your values.

# Application
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/guest_housing

# Authentication
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS allowed origins (web frontend)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Paymob Payment Gateway (leave blank for demo mode)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_KEY=
PAYMOB_INTEGRATION_ID=
