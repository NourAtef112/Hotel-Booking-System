# E-JUST Guest Housing: production settings
# Copy to .env.production and fill in every value. Never commit .env.production.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=housing
POSTGRES_DB=ejust_housing
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Security ---------------------------------------------------------------
# Signs login tokens. Generate with: openssl rand -hex 32  (at least 32 characters)
SECRET_KEY=
# Public HTTPS addresses of the guest site and admin dashboard, comma-separated.
# Include the Framer site address while the guest site is hosted on Framer.
ALLOWED_ORIGINS=https://housing.ejust.edu.eg,https://housing-admin.ejust.edu.eg
PUBLIC_BASE_URL=https://housing.ejust.edu.eg
# How long a login stays valid, in hours
ACCESS_TOKEN_EXPIRE_HOURS=12

# --- Ports on this server (put the HTTPS reverse proxy in front of these) ----
API_PORT=8000
ADMIN_PORT=8080
GUEST_PORT=80

# --- Behaviour --------------------------------------------------------------
# Load sample rooms on first start. Keep false and enter the real rooms in the dashboard.
SEED_DEMO_DATA=false
# Online card payment. false = guests pay at reception and staff confirm the booking.
PAYMENTS_ENABLED=false
# API worker processes (roughly 2 x CPU cores)
WEB_CONCURRENCY=4
# Days of nightly database backups to keep in ./backups
BACKUP_KEEP_DAYS=14

# --- Paymob (only when PAYMENTS_ENABLED=true) --------------------------------
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_KEY=
PAYMOB_INTEGRATION_ID=

# --- Firebase Google sign-in (optional) -------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
